<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Author Bio"
    sling:resourceType="cq/gui/components/authoring/dialog"
    extraClientlibs="[component.validation.author]">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <firstname
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldDescription="Enter Your First Name"
                        fieldLabel="First Name"
                        name="./fname"
                        validation="geeks-text-validation"/>
                    <lastname
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldDescription="Enter Your Last Name"
                        fieldLabel="Last Name"
                        name="./lname"
                        validation="geeks-text-validation"/>
                    <isprofessor
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                        checked="{Boolean}true"
                        name="./isProfessor"
                        text="Author is also a Professor?"
                        value="{Boolean}true"/>
                    <authorbooks
                        granite:class="geeks-multifield"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                        fieldDescription="Provide Author Books"
                        fieldLabel="Author Books"
                        margin="{Boolean}true"
                        validation="geeks-multifield-validation">
                        <field
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            name="./authorbooks"/>
                        <granite:data
                            jcr:primaryType="nt:unstructured"
                            max-items="{Long}5"
                            min-items="{Long}3"/>
                    </authorbooks>
                    <bookdetailswithmap
                        granite:class="geeks-multifield"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                        composite="{Boolean}true"
                        fieldDescription="Provide Author Book Details"
                        fieldLabel="Book Details">
                        <field
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            name="./bookdetailswithmap">
                            <items jcr:primaryType="nt:unstructured">
                                <bookname
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldDescription="Provide Book Name"
                                    fieldLabel="Book Name"
                                    name="./bookname"/>
                                <booksubject
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldDescription="Provide Book Subject"
                                    fieldLabel="Book Subject"
                                    name="./booksubject"/>
                                <publishyear
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldDescription="Provide Book Publish Year"
                                    fieldLabel="Publish Year"
                                    name="./publishyear"/>
                            </items>
                        </field>
                    </bookdetailswithmap>
                </items>
            </column>
        </items>
    </content>
</jcr:root>
